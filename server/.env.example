# Copy this file to .env and fill in real values. Never commit .env.

# Express
PORT=3000

# Set to production on Railway (enables secure cookies)
NODE_ENV=development

# MongoDB (required for chat history and rooms)
MONGODB_URI=

# Authentication database: mongodb (recommended) or postgres
AUTH_DB=mongodb

# PostgreSQL / Supabase (optional; only required when AUTH_DB=postgres)
POSTGRES_URI=
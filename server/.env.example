# Copy this file to .env and fill in real values. Never commit .env.

# Express
PORT=3000

# Set to production on Railway (enables secure cookies)
NODE_ENV=development

# MongoDB (required for chat history and rooms)
MONGODB_URI=

# Authentication database: mongodb (recommended) or postgres
AUTH_DB=mongodb

# PostgreSQL / Supabase (optional; only required when AUTH_DB=postgres)
POSTGRES_URI=

# Stripe (sandbox / test mode keys only in development)
STRIPE_SECRET_KEY=
# From `stripe listen` output (whsec_...) in dev, or the Dashboard webhook endpoint in prod
STRIPE_WEBHOOK_SECRET=
# Price ID for the premium Mewtwo room
STRIPE_PRICE_MEWTWO=

# Where Stripe Checkout sends the browser back to (Vite dev server in development)
CLIENT_URL=
